¨@-- used for the pause function
local pause = require "scripts.pause" 

local GRAVITY = 300
local SPEED = 50
local TILE_SIZE = 16
local JUMP_HEIGHT = 150


local function handle_level_collisions(self,normal,distance)

	-- handling the compensation
	distance = distance * vmath.length(normal)

	if distance > 0 then
		local projection = vmath.project(self.correction, normal * distance)
		if projection < 1 then 
			local compensation = (distance - distance * projection)* normal
			self.char_pos = self.char_pos + compensation
			go.set_position(self.char_pos)
			self.correction = self.correction + compensation
		end
	end

	-- ground contact
	if normal.y > 0.7 then  
		if not self.is_knocked then 
			self.velocity.y = 0
			self.ground_contact = true
			self.double_jump_available = false 
		end
	end

	-- Handle wall collisions separately
	if normal.x ~= 0 and math.abs(normal.y) < 0.7 then
		
		self.velocity.x = 0
	end

	-- Ceiling collision
	if normal.y < 0 then
	
		self.velocity.y = 0
	
	end
end

local function pick_up_tile(tile_x,tile_y)
	--removes the tile 
	tilemap.set_tile('/level1#level1_TM', 'power ups', tile_x, tile_y, 0)
end

local function check_tile_for_pickup(self)
	
	-- converting to tile coordinaates
	local tile_x = math.floor(self.char_pos.x/TILE_SIZE) + 1
	local tile_y = math.floor(self.char_pos.y/TILE_SIZE) + 1
	-- checks the coordinates are inbounds
	if (self.tilemap_y <= tile_y and tile_y <= self.tilemap_y + self.tilemap_h - 1) and
	(self.tilemap_x <= tile_x and  tile_x  <= self.tilemap_x + self.tilemap_w - 1) then

		--gets the tile at the players position
		local tile = tilemap.get_tile('/level1#level1_TM', 'power ups', tile_x, tile_y)
		if tile > 0 then
			-- health tile red mushroom
			if tile == 34 then
				msg.post('/gui#level1_screen', "health power up")
				msg.post('/level1', 'spawn power up')
				-- blue mushroom jump heigth
			elseif tile == 1 then
				-- double jump heigth
				JUMP_HEIGHT = JUMP_HEIGHT * 1.35
				-- after 7 seconds revert it back
				timer.delay(7, false, function()
					JUMP_HEIGHT = JUMP_HEIGHT/1.35
				end)
				msg.post('/level1', 'spawn power up')
			elseif tile == 66 then
				
				-- the increase in speed
				local ran_num = 1.5 + 0.5* math.random()
				SPEED = SPEED * ran_num
				-- revert it back
				timer.delay(7, false, function()
					SPEED = SPEED/ran_num
				end)
				msg.post('/level1', 'spawn power up')
			end	
			-- spawn a new power up in the world
			pick_up_tile(tile_x,tile_y)
		end
	end
end

local function update_progress(self) 
	-- first we calculate how much of the x axis we have we progressed through and then
	-- we floor it to get the lowest integer and multiple it by 100 to get the percentage
	self.progress = math.floor((self.char_pos.x/self.bound_x) * 100)

	msg.post('/gui', 'update progress', {progress = self.progress})
end
function init(self)
	-- this is to make the level initialise with the correct pause state 
	pause.set_pause(false)
	msg.post('.', 'acquire_input_focus')
	msg.post('@render:','use_camera_projection')
	msg.post('operator#camera', 'acquire_camera_focus')
	self.animation = nil
	self.ground_contact = false
	self.velocity = vmath.vector3()
	self.correction = vmath.vector3()
	self.is_knocked = false
	math.randomseed(os.time())
	self.ready_to_fire = true
	self.shooting = false
	self.double_jump_available = false
	self.char_pos = go.get_position()
	-- this is for calculating the progress through the map
	self.progress = 0 
	-- the bounds
	self.tilemap_x, self.tilemap_y, self.tilemap_w, self.tilemap_h = tilemap.get_bounds('/level1#level1_TM')
	-- calculate the length of the x axis
	self.bound_x = (self.tilemap_w + self.tilemap_x - 2.5) * TILE_SIZE
	

end

function on_input(self, action_id, action)
	-- Jump action triggered
	if action_id == hash('up') and action.pressed then

		-- First jump: when the player is grounded
		if self.velocity.y == 0  then
			self.velocity.y = JUMP_HEIGHT
			self.ground_contact = false   -- Player is no longer on the ground
			self.double_jump_available = true  -- Enable double jump
		-- Second jump: when the player is already jumping
		elseif  self.double_jump_available then
			self.velocity.y = JUMP_HEIGHT  
			self.double_jump_available = false -- Disable further jumps until grounded
		end
	end
	-- left movement	
	if action_id == hash('left') then 
		self.velocity.x = -SPEED
	end
	-- right movement	
	if action_id == hash('right') then 
		self.velocity.x = SPEED
	end
	-- shooting handling 
	if action_id == hash('shoot') and action.pressed and self.ready_to_fire then 
		self.ready_to_fire = false
		self.shooting = true
	end
	-- handles the pause state
	if action_id == hash('pause') and action.released then
		-- flips the state
		pause.set_pause(not pause.is_paused)
		--shows the pause screen
		if pause.is_paused then
			msg.post("/pause_screen", "show_pause")
		else
			msg.post("/pause_screen", "hide_pause")
		end 
	end
end


function update(self, dt)
	if pause.is_paused then
		-- Skip updating the game object logic if paused
		return
	end

	-- falls to death so loads the game over screen
	if self.char_pos.y < -10 then
		msg.post("main:/soundtrack", 'short mute',{mute_time = 8})
		msg.post("main:/controller", "play game over")
	end
	check_tile_for_pickup(self)
	-- gravity 
	if not self.ground_contact then
		self.velocity.y = self.velocity.y - GRAVITY * dt
	end
	
	-- player animation 
	local animation = hash('idle')
	if self.velocity.x < 0 then 
		animation = hash('left')
	elseif self.velocity.x > 0 then 
		animation = hash('right')
	
	elseif self.velocity.y > 0 then
		if self.velocity.x < 0 then
			animation = hash('left jump')
		elseif self.velocity.x > 0 then
			animation = hash('right jump')
		else  
			animation = hash('up jump')
		end
	end
	-- when the player is shooting
	if self.shooting then
		--plays the animation according to the direction of the player is going
		if self.velocity.x >= 0 then
			msg.post('#sprite', 'play_animation', {id = hash('shoot right')})
		else
			msg.post('#sprite', 'play_animation', {id = hash('shoot left')})
		end
		-- sends a message to the bullet with the velocity
		msg.post('/bullet', 'shooting direction', {direction = self.velocity.x})
		-- stops the animation of shooting
		timer.delay(0.3, false, function()
			self.animation = hash('idle')
			msg.post('#sprite', 'play_animation', {id = animation})
		end)
		-- makes sure this runs only once so there is only one message being sent
		self.shooting = false
	end
	if animation ~= self.animation then 
		
		msg.post('#sprite', 'play_animation', {id = animation})
		self.animation = animation
	end
	-- update position
	self.char_pos = self.char_pos + self.velocity * dt
	go.set_position(self.char_pos)
	-- updates the progress
	update_progress(self) 
	-- reset 
	self.correction = vmath.vector3()
	self.velocity.x = 0
	self.ground_contact = false
end


function on_message(self, message_id, message, sender, dt)
	-- stops the on message function from running
	if pause.is_paused then 
		return
	end
	
	if message_id == hash('contact_point_response') then
		-- the character interacts with the portal(finishes the level)
		if message.other_group == hash('portal') then
			pause.set_pause(not pause.is_paused)
			msg.post('/level_completion screen', 'show complete')
			msg.post('.', 'release_input_focus')
			-- this will send a message to the level1 gui
			-- to send the data to level complete screen gui
			msg.post('gui', 'send data to lcs')
		end
		-- if the charcater is touching the ground
		if message.other_group == hash('ground') then
			handle_level_collisions(self, message.normal, message.distance)
		end
		-- the character gets in contact with a mob
		if message.group == hash('Mob') then
			-- knockback is initiated
			local knockback_direction = vmath.vector3((300 * (self.velocity.x <= 0 and 1 or -1)), 100, 0)
			self.velocity = knockback_direction
			self.is_knocked = true
			timer.delay(0.5, false, function()
				self.is_knocked = false
			end)
		end

	end
	-- reloading the bullet
	if message_id == hash('reload_bullet') then
		-- Handle reload logic here

		self.ready_to_fire = true
	end
end 

function final(self)
	msg.post(".", "release_input_focus")
	msg.post('operator#camera', 'disable')
end




